rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 사용자 데이터 (본인 쓰기 가능, 모두가 읽기 가능 - 통계 및 명단을 위해 리스팅 허용)
    match /users/{document=**} {
      allow read: if request.auth != null;
      // Allow any authenticated user to write (simplified for admin approval)
      allow write: if request.auth != null;
    }
    
    // 공개 데이터
    match /join_requests/{document=**} {
      allow read, write: if true;
    }
    match /members/{document=**} {
      allow read, write: if true;
    }
    match /hymns/{document=**} {
      allow read, write: if true;
    }
    match /board_categories/{document=**} {
      allow read, write: if true;
    }
    match /boards/{document=**} {
      allow read, write: if true;
    }
    match /board_posts/{document=**} {
      allow read, write: if true;
    }
    match /settings/{document=**} {
      allow read, write: if true;
    }
    match /attendance/{document=**} {
      allow read, write: if true;
    }
    

    // 찬송가 연습 자료 (저작권 자료): 승인된 로그인 사용자만 읽기, 대장·지휘자만 쓰기
    function approvedUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role != '대기권한';
    }
    function conductorUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['대장', '지휘자'];
    }
    match /hymn_meta/{id} {
      allow read: if approvedUser();
      allow write: if conductorUser();
    }
    match /hymn_songs/{id} {
      allow read: if approvedUser();
      allow write: if conductorUser();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
